{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "atolle",
  "main": "./cloudflare/src/worker.ts",
  "compatibility_date": "2026-09-14",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "env": {
    "staging": {
      "name": "atolle-staging",
      "workers_dev": true,
      "routes": [
        {
          "pattern": "maldivesliveaboardbooking.com",
          "custom_domain": true
        },
        {
          "pattern": "www.maldivesliveaboardbooking.com",
          "custom_domain": true
        }
      ],
      "assets": {
        "directory": "./public",
        "binding": "ASSETS",
        "run_worker_first": true
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "atolle-staging",
          "database_id": "7426e4a1-ff8a-4bea-8f3c-56a7e52144a2",
          "migrations_dir": "cloudflare/migrations"
        }
      ],
      "vars": {
        "ENVIRONMENT": "staging",
        "ENFORCE_AUTH": "1",
        "SESSION_HOURS": "24",
        "BML_MODE": "mock",
        "BML_ENV": "sandbox",
        "BML_CURRENCY": "USD"
      }
    }
  }
}
